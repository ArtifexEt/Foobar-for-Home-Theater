#include "height_resource.h"
#include <winres.h>
#include <commctrl.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

IDD_HEIGHT_DSP_CONFIG DIALOGEX 0, 0, 360, 178
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Add Ceiling Speakers"
FONT 9, "Segoe UI", 400, 0, 1
{
    LTEXT       "Adds missing height channels without changing the existing bed.", -1, 10, 9, 340, 18
    LTEXT       "Ceiling layout", -1, 10, 35, 116, 12
    COMBOBOX    IDC_HEIGHT_LAYOUT, 132, 33, 218, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Height gain (dB)", -1, 10, 57, 116, 12
    CONTROL     "", IDC_HEIGHT_GAIN_SLIDER, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ | TBS_NOTICKS, 132, 55, 164, 14
    EDITTEXT    IDC_HEIGHT_GAIN, 304, 55, 46, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT       "Top middle trim (dB)", IDC_TOP_MIDDLE_LABEL, 10, 77, 116, 12
    CONTROL     "", IDC_TOP_MIDDLE_GAIN_SLIDER, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ | TBS_NOTICKS, 132, 75, 164, 14
    EDITTEXT    IDC_TOP_MIDDLE_GAIN, 304, 75, 46, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT       "Front difference (0..1)", -1, 10, 97, 116, 12
    CONTROL     "", IDC_FRONT_DIFFERENCE_SLIDER, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ | TBS_NOTICKS, 132, 95, 164, 14
    EDITTEXT    IDC_FRONT_DIFFERENCE, 304, 95, 46, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT       "Surround / rear feed (0..1)", -1, 10, 117, 116, 12
    CONTROL     "", IDC_SURROUND_FEED_SLIDER, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ | TBS_NOTICKS, 132, 115, 164, 14
    EDITTEXT    IDC_SURROUND_FEED, 304, 115, 46, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT       "Center feed (0..0.5)", -1, 10, 137, 116, 12
    CONTROL     "", IDC_MID_FEED_SLIDER, "msctls_trackbar32", WS_TABSTOP | TBS_HORZ | TBS_NOTICKS, 132, 135, 164, 14
    EDITTEXT    IDC_MID_FEED, 304, 135, 46, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
    DEFPUSHBUTTON "OK", IDOK, 246, 156, 50, 14
    PUSHBUTTON  "Cancel", IDCANCEL, 300, 156, 50, 14
}
