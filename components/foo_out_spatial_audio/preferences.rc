#include "preferences_resource.h"

#include <winres.h>
#include <commctrl.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

IDD_SPATIAL_AUDIO_PREFERENCES DIALOGEX 0, 0, 560, 360
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    CONTROL     "", idTabs, "SysTabControl32", TCS_TABS | WS_TABSTOP, 5, 5, 550, 350
}

IDD_SPATIAL_AUDIO_PAGE_LAYOUT DIALOGEX 0, 0, 530, 322
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    LTEXT       "Bed", IDC_STATIC, 11, 12, 45, 13
    COMBOBOX    idLayoutMode, 64, 9, 185, 98, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Rate", IDC_STATIC, 270, 12, 35, 13
    COMBOBOX    idSampleRateMode, 309, 9, 185, 135, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Probe", idProbeEndpoint, 11, 34, 70, 15
    EDITTEXT    idEndpointSummary, 11, 55, 508, 248, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
}

IDD_SPATIAL_AUDIO_PAGE_TEST DIALOGEX 0, 0, 530, 322
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    CONTROL     "Dynamic object", idDirectionalTestDynamic, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 11, 10, 100, 13
    LTEXT       "Direction", IDC_STATIC, 11, 32, 50, 13
    COMBOBOX    idDirectionalTestTarget, 64, 29, 145, 135, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Run", idDirectionalTestRunSelected, 216, 29, 55, 15
    LTEXT       "Gain", IDC_STATIC, 292, 32, 32, 13
    EDITTEXT    idDirectionalTestGain, 326, 30, 42, 13, ES_AUTOHSCROLL
    LTEXT       "Hz", IDC_STATIC, 383, 32, 18, 13
    EDITTEXT    idDirectionalTestFrequency, 404, 30, 50, 13, ES_AUTOHSCROLL
    PUSHBUTTON  "Top FL", idTestButtonTopFrontLeft, 205, 74, 58, 17
    PUSHBUTTON  "Top FR", idTestButtonTopFrontRight, 267, 74, 58, 17
    PUSHBUTTON  "Front L", idTestButtonFrontLeft, 174, 104, 58, 17
    PUSHBUTTON  "Center", idTestButtonFrontCenter, 236, 104, 58, 17
    PUSHBUTTON  "Front R", idTestButtonFrontRight, 298, 104, 58, 17
    PUSHBUTTON  "Side L", idTestButtonSideLeft, 174, 134, 58, 17
    LTEXT       "Listener", IDC_STATIC, 237, 138, 55, 13
    PUSHBUTTON  "Side R", idTestButtonSideRight, 298, 134, 58, 17
    PUSHBUTTON  "Back L", idTestButtonBackLeft, 174, 164, 58, 17
    PUSHBUTTON  "LFE", idTestButtonLfe, 236, 164, 58, 17
    PUSHBUTTON  "Back R", idTestButtonBackRight, 298, 164, 58, 17
    PUSHBUTTON  "Top BL", idTestButtonTopBackLeft, 205, 194, 58, 17
    PUSHBUTTON  "Top BR", idTestButtonTopBackRight, 267, 194, 58, 17
}

IDD_SPATIAL_AUDIO_PAGE_ABOUT DIALOGEX 0, 0, 530, 322
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    LTEXT       "Spatial Audio Output", IDC_STATIC, 11, 9, 250, 13
    LTEXT       "", idAboutVersion, 11, 25, 250, 13
    PUSHBUTTON  "Buy me a coffee", idSupportButton, 11, 44, 110, 14
    PUSHBUTTON  "GitHub repo", idGitHubButton, 125, 44, 110, 14
}
