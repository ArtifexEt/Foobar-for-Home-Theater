#include "preferences_resource.h"

#include <winres.h>
#include <commctrl.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

IDD_SPATIAL_AUDIO_PREFERENCES DIALOGEX 0, 0, 507, 290
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    CONTROL     "", idTabs, "SysTabControl32", TCS_TABS | WS_TABSTOP, 5, 5, 496, 280
}

IDD_SPATIAL_AUDIO_PAGE_LAYOUT DIALOGEX 0, 0, 480, 305
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    LTEXT       "Output bed", IDC_STATIC, 11, 11, 95, 13
    COMBOBOX    idLayoutMode, 109, 9, 165, 98, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Render rate", IDC_STATIC, 11, 30, 95, 13
    COMBOBOX    idSampleRateMode, 109, 28, 165, 135, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Probe endpoint", idProbeEndpoint, 11, 53, 110, 14
    EDITTEXT    idEndpointSummary, 11, 73, 300, 160, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
}

IDD_SPATIAL_AUDIO_PAGE_TEST DIALOGEX 0, 0, 480, 305
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    CONTROL     "Prefer dynamic object", idDirectionalTestDynamic, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 11, 9, 120, 13
    LTEXT       "Direction", IDC_STATIC, 11, 31, 55, 13
    COMBOBOX    idDirectionalTestTarget, 69, 29, 110, 135, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Run selected", idDirectionalTestRunSelected, 183, 29, 75, 14
    LTEXT       "Test gain (dB)", IDC_STATIC, 11, 50, 95, 13
    EDITTEXT    idDirectionalTestGain, 109, 50, 37, 13, ES_AUTOHSCROLL
    LTEXT       "Frequency (Hz)", IDC_STATIC, 11, 69, 95, 13
    EDITTEXT    idDirectionalTestFrequency, 109, 69, 37, 13, ES_AUTOHSCROLL
    PUSHBUTTON  "Top FL", idTestButtonTopFrontLeft, 90, 90, 55, 16
    PUSHBUTTON  "Top FR", idTestButtonTopFrontRight, 148, 90, 55, 16
    PUSHBUTTON  "Front L", idTestButtonFrontLeft, 61, 116, 55, 16
    PUSHBUTTON  "Center", idTestButtonFrontCenter, 119, 116, 55, 16
    PUSHBUTTON  "Front R", idTestButtonFrontRight, 177, 116, 55, 16
    PUSHBUTTON  "Side L", idTestButtonSideLeft, 61, 142, 55, 16
    LTEXT       "Listener", IDC_STATIC, 119, 146, 55, 13
    PUSHBUTTON  "Side R", idTestButtonSideRight, 177, 142, 55, 16
    PUSHBUTTON  "Back L", idTestButtonBackLeft, 61, 168, 55, 16
    PUSHBUTTON  "LFE", idTestButtonLfe, 119, 168, 55, 16
    PUSHBUTTON  "Back R", idTestButtonBackRight, 177, 168, 55, 16
    PUSHBUTTON  "Top BL", idTestButtonTopBackLeft, 90, 194, 55, 16
    PUSHBUTTON  "Top BR", idTestButtonTopBackRight, 148, 194, 55, 16
}

IDD_SPATIAL_AUDIO_PAGE_ABOUT DIALOGEX 0, 0, 480, 305
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    LTEXT       "Spatial Audio Output", IDC_STATIC, 11, 9, 250, 13
    LTEXT       "", idAboutVersion, 11, 25, 250, 13
    PUSHBUTTON  "Buy me a coffee", idSupportButton, 11, 44, 110, 14
    PUSHBUTTON  "GitHub repo", idGitHubButton, 125, 44, 110, 14
}
