#include "preferences_resource.h"

#include <winres.h>
#include <commctrl.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

IDD_SPATIAL_AUDIO_PREFERENCES DIALOGEX 0, 0, 507, 290
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    CONTROL     "", idTabs, "SysTabControl32", TCS_TABS | WS_TABSTOP, 5, 5, 496, 280
}

IDD_SPATIAL_AUDIO_PAGE_LAYOUT DIALOGEX 0, 0, 480, 305
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    LTEXT       "Output bed", IDC_STATIC, 11, 11, 95, 13
    COMBOBOX    idLayoutMode, 109, 9, 165, 98, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Render rate", IDC_STATIC, 11, 30, 95, 13
    COMBOBOX    idSampleRateMode, 109, 28, 165, 135, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
}

IDD_SPATIAL_AUDIO_PAGE_TEST DIALOGEX 0, 0, 480, 305
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    CONTROL     "Enable test tone", idDirectionalTestEnabled, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 11, 9, 120, 13
    CONTROL     "Prefer dynamic object", idDirectionalTestDynamic, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 9, 120, 13
    LTEXT       "Direction", IDC_STATIC, 11, 31, 55, 13
    COMBOBOX    idDirectionalTestTarget, 69, 29, 110, 135, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Test gain (dB)", IDC_STATIC, 11, 50, 95, 13
    EDITTEXT    idDirectionalTestGain, 109, 50, 37, 13, ES_AUTOHSCROLL
    LTEXT       "Frequency (Hz)", IDC_STATIC, 11, 69, 95, 13
    EDITTEXT    idDirectionalTestFrequency, 109, 69, 37, 13, ES_AUTOHSCROLL
}

IDD_SPATIAL_AUDIO_PAGE_ABOUT DIALOGEX 0, 0, 480, 305
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 1
{
    LTEXT       "Spatial Audio Output for Foobar2000", IDC_STATIC, 11, 9, 250, 13
    LTEXT       "", idAboutVersion, 11, 25, 250, 13
    PUSHBUTTON  "Buy me a coffee", idSupportButton, 11, 44, 110, 14
    PUSHBUTTON  "GitHub repo", idGitHubButton, 125, 44, 110, 14
}
